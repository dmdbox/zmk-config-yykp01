#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    macros {

disconnect_all: disconnect_all {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <200>;
    tap-ms = <40>;
    bindings = <
        <&bt BT_SEL 4>,
        <&macro_wait_time 500>,
        <&bt BT_DISC 0>,
        <&macro_wait_time 250>,
        <&bt BT_DISC 1>,
        <&macro_wait_time 250>,
        <&bt BT_DISC 2>,
        <&macro_wait_time 250>,
        <&bt BT_DISC 3>,
        <&macro_wait_time 250>,
        <&bt BT_DISC 4>;
    >;
};

clear_all: clear_all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_wait_time 500>,
                <&bt BT_SEL 4>,
                <&macro_wait_time 500>,
                <&bt BT_CLR>,
                <&macro_wait_time 500>,

                <&macro_wait_time 500>,
                <&bt BT_SEL 3>,
                <&macro_wait_time 500>,
                <&bt BT_CLR>,
                <&macro_wait_time 500>,

                <&macro_wait_time 500>,
                <&bt BT_SEL 2>,
                <&macro_wait_time 500>,
                <&bt BT_CLR>,
                <&macro_wait_time 500>,

                <&macro_wait_time 500>,
                <&bt BT_SEL 1>,
                <&macro_wait_time 500>,
                <&bt BT_CLR>,
                <&macro_wait_time 500>,

                <&macro_wait_time 500>,
                <&bt BT_SEL 0>,
                <&macro_wait_time 500>,
                <&bt BT_CLR>,
                <&macro_wait_time 500>;
        };

switch_layer0: switch_layer0 {
        label = "SWITCH_LAYER0";
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        wait-ms = <40>;
        tap-ms = <40>;
        bindings = <
            &to 0
            &kp LS(A)
            &kp LS(L)
            &kp N0
            &kp HASH
        >;
    };

    switch_layer1: switch_layer1 {
        label = "SWITCH_LAYER1";
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        wait-ms = <40>;
        tap-ms = <40>;
        bindings = <
            &to 1
            &kp LS(A)
            &kp LS(L)
            &kp N1
            &kp HASH
        >;
    };

    switch_layer2: switch_layer2 {
        label = "SWITCH_LAYER2";
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        wait-ms = <40>;
        tap-ms = <40>;
        bindings = <
            &to 2
            &kp LS(A)
            &kp LS(L)
            &kp N2
            &kp HASH
        >;
    };

    switch_layer3: switch_layer3 {
        label = "SWITCH_LAYER3";
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        wait-ms = <40>;
        tap-ms = <40>;
        bindings = <
            &to 3
            &kp LS(A)
            &kp LS(L)
            &kp N3
            &kp HASH
        >;
    };

    switch_layer4: switch_layer4 {
        label = "SWITCH_LAYER4";
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        wait-ms = <40>;
        tap-ms = <40>;
        bindings = <
            &to 4
            &kp LS(A)
            &kp LS(L)
            &kp N4
            &kp HASH
        >;
    };

    switch_layer5: switch_layer5 {
        label = "SWITCH_LAYER5";
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        wait-ms = <40>;
        tap-ms = <40>;
        bindings = <
            &to 5
            &kp LS(A)
            &kp LS(L)
            &kp N5
            &kp HASH
        >;
    };

    switch_layer6: switch_layer6 {
        label = "SWITCH_LAYER6";
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        wait-ms = <40>;
        tap-ms = <40>;
        bindings = <
            &to 6
            &kp LS(A)
            &kp LS(L)
            &kp N6
            &kp HASH
        >;
    };

    switch_layer7: switch_layer7 {
        label = "SWITCH_LAYER7";
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        wait-ms = <40>;
        tap-ms = <40>;
        bindings = <
            &to 7
            &kp LS(A)
            &kp LS(L)
            &kp N7
            &kp HASH
        >;
    };

    switch_layer8: switch_layer8 {
        label = "SWITCH_LAYER8";
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        wait-ms = <40>;
        tap-ms = <40>;
        bindings = <
            &to 8
            &kp LS(A)
            &kp LS(L)
            &kp N8
            &kp HASH
        >;
    };

    switch_layer9: switch_layer9 {
        label = "SWITCH_LAYER9";
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        wait-ms = <40>;
        tap-ms = <40>;
        bindings = <
            &to 9
            &kp LS(A)
            &kp LS(L)
            &kp N9
            &kp HASH
        >;
    };

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &studio_unlock    &bt BT_SEL 0        &bt BT_CLR          &bt BT_DISC 0          &bootloader
                &none             &bt BT_SEL 1        &bt BT_CLR          &bt BT_DISC 1          &sys_reset
                &none             &bt BT_SEL 2        &bt BT_CLR          &bt BT_DISC 2          &clear_all
                &none             &kp N0              &kp DOT             &kp N0                 &disconnect_all
                &none             &none               &none               &studio_unlock         &switch_layer1
            >;
        };

        layout1 {
            bindings = <
                &kp ESC    &kp R         &kp T        &kp C          &kp I
                &kp N1     &kp N2        &kp N3       &kp N4         &kp N5
                &kp TAB    &kp Q         &kp W        &kp E          &kp R
                &kp TAB    &kp F3        &kp F2       &kp F1         &kp T
                &kp LCTRL  &kp LALT      &kp LSHFT    &studio_unlock &switch_layer2
            >;
        };

        layout2 {
            bindings = <
                &kp ESC    &kp R         &kp T        &kp C          &kp I
                &kp N1     &kp N1        &kp N1       &kp N1         &kp N2
                &kp TAB    &kp SPACE     &kp W        &kp E          &kp W
                &kp TAB    &none         &none        &kp T          &kp R
                &kp LSHFT  &kp LALT      &kp LCTRL    &studio_unlock &switch_layer3
            >;
        };

        layout3 {
            bindings = <
                &kp ESC    &kp T         &kp P        &kp C          &kp I
                &kp N1     &kp N1        &kp N2       &kp N2         &kp W
                &kp TAB    &kp Q         &none        &none          &kp W
                &kp D      &none         &none        &kp E          &kp E
                &kp LSHFT  &kp E         &kp LALT     &studio_unlock &switch_layer4
            >;
        };

        layout4 {
            bindings = <
                &kp ESC    &kp N1        &none        &none          &kp TAB
                &kp N1     &none         &kp W        &kp LCTRL      &kp R
                &kp LSHFT  &kp A         &kp S        &kp D          &kp E
                &kp LSHFT  &kp Z         &kp X        &kp C          &kp F
                &kp SPACE  &kp LSHFT     &kp SPACE    &studio_unlock &switch_layer5
            >;
        };

        layout5 {
            bindings = <
                &kp ESC    &kp E         &kp Z        &kp A          &kp I
                &kp Q      &kp Q         &kp Q        &kp Q          &kp N4
                &kp TAB    &kp N1        &none        &kp D          &kp Z
                &kp LCTRL  &kp Z         &kp X        &kp N4         &kp N3
                &kp SPACE  &kp LALT      &kp LSHFT    &studio_unlock &switch_layer6
            >;
        };

        layout6 {
            bindings = <
                &kp ESC    &kp W         &none        &kp C          &kp I
                &kp N1     &kp N2        &none        &kp N3         &kp N4
                &kp TAB    &kp F4        &none        &kp F2         &kp F3
                &none      &none         &none        &kp F2         &kp F1
                &kp LCTRL  &kp LCTRL     &kp LSHFT    &studio_unlock &switch_layer7
            >;
        };

        layout7 {
            bindings = <                                        
                &kp ESC    &kp N2        &kp N3       &kp N4         &kp I
                &kp M      &kp Z         &kp W        &kp C          &kp R
                &kp LSHFT  &kp A         &kp S        &kp D          &kp F
                &kp LCTRL  &kp N7        &kp F5       &kp L          &kp N1
                &kp E      &kp SPACE     &kp Q        &studio_unlock &switch_layer8
            >;
        };

        layout8 {
            bindings = <
                &kp ESC    &none         &none        &kp C          &kp I
                &kp N1     &kp N2        &kp W        &kp N3         &kp N4
                &none      &kp A         &kp S        &kp D          &kp E
                &kp LSHFT  &kp Z         &kp X        &kp C          &kp F
                &kp N5     &kp LALT      &kp N5       &studio_unlock &switch_layer9
            >;
        };

        layout9 {
            bindings = <
                &kp ESC    &kp N1        &kp N2       &kp N3         &kp N4
                &kp TAB    &kp Q         &kp W        &kp E          &kp R
                &kp LSHFT  &kp A         &kp S        &kp D          &kp F
                &kp LCTRL  &kp Z         &kp X        &kp C          &kp V
                &kp LCTRL  &kp LALT      &kp SPACE    &studio_unlock &switch_layer0
            >;
        };
    };
    
};
